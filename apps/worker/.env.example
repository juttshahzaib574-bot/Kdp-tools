# Copy this file to .env and fill in real values.
# Never commit .env — it's already in .gitignore.

# Same Postgres database as apps/web.
DATABASE_URL=

# The grid-mystery puzzle generator is fully deterministic — no LLM/API key
# needed here. If a future book type adds AI-generated content, its key
# would be configured the same way, scoped to that generator only.

# S3-compatible object storage for generated PDFs (Cloudflare R2, Supabase
# Storage, or AWS S3 all work). If left blank, the worker writes PDFs to
# ./.local-storage for local development only — do not rely on that in
# production, it is not durable.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
