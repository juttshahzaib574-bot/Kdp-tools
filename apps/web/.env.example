# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Postgres connection string (Neon or Supabase both give you this directly
# from their dashboard, e.g. postgresql://user:pass@host/dbname?sslmode=require)
DATABASE_URL=

# Clerk (Dashboard -> API Keys)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk (Dashboard -> Webhooks -> your endpoint's Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=

# Upstash Redis (used for rate limiting). Optional locally; required in
# production or rate limiting is silently disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe (Dashboard -> Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# S3-compatible object storage. REQUIRED in production — user image uploads
# and generated PDFs both live here, and without it every upload returns a
# 503 telling the user object storage isn't configured. Cloudflare R2 is
# recommended because its egress is free (uploads and downloads both cost
# money on AWS S3, only storage costs money on R2), which matters a lot
# for an image-heavy app. Setup, roughly:
#   1. Create a bucket at cloudflare.com/products/r2 (free tier: 10GB/mo)
#   2. R2 dashboard -> Manage R2 API Tokens -> create a token with Read+Write
#   3. Paste the four values below (endpoint looks like
#      https://<account-id>.r2.cloudflarestorage.com)
# Locally these can stay blank — the app falls back to writing files under
# apps/web/.local-storage and reading them right back.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
