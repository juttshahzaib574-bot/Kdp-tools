{
  "name": "@kdp/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:workers && next dev",
    "build": "pnpm --filter @kdp/db generate && pnpm build:workers && next build",
    "vercel-build": "pnpm --filter @kdp/db generate && pnpm --filter @kdp/db migrate:deploy && pnpm build:workers && next build",
    "build:workers": "node scripts/build-workers.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.679.0",
    "@clerk/nextjs": "^7.8.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kdp/db": "workspace:*",
    "@kdp/generator-grid-mystery": "workspace:*",
    "@kdp/shared": "workspace:*",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.33.5",
    "svix": "^1.42.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
