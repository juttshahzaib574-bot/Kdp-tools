# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/public/workers/
# Interior typefaces, copied from the generator package's assets/ by
# scripts/build-workers.mjs so the browser preview embeds the same faces
# the server export does. Build output, not source.
/public/fonts/
# Baked artwork, copied from the generator package's assets/ by the same
# script and for the same reason — the browser preview must draw the art
# the export draws. Build output, not source: the library lives in
# assets/packs/ and the baked copies in the generator package.
/public/art/
